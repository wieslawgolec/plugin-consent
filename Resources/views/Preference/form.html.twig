<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Communication preferences</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: system-ui, sans-serif; max-width: 32rem; margin: 2rem auto; padding: 0 1rem; color: #1e293b; }
        h1 { font-size: 1.35rem; }
        .hint { color: #64748b; font-size: 0.9rem; margin-bottom: 1.5rem; }
        label { display: block; margin: 0.75rem 0; }
        button { background: #2563eb; color: #fff; border: 0; padding: 0.6rem 1.2rem; border-radius: 0.375rem; cursor: pointer; }
        button:hover { background: #1d4ed8; }
    </style>
</head>
<body>
    <h1>Communication preferences</h1>
    <p class="hint">Choose which types of messages you want to receive. This does not change website tracking settings.</p>
    <form method="post" action="{{ path('mautic_consent_preference_save', {token: token}) }}">
        {% for field in fields %}
            <label>
                <input type="checkbox" name="{{ field.name }}" value="1"
                    {% if field.required %}required{% endif %}>
                {{ field.label }}
            </label>
        {% endfor %}
        <p style="margin-top: 1.5rem;">
            <button type="submit">Save preferences</button>
        </p>
    </form>
</body>
</html>
